    given-names: Juan Pablo
    orcid: https://orcid.org/0009-0007-5755-883X
keywords:
  - Argentina
  - Senate
  - parliamentary debate
  - legislative speech
  - stenographic transcripts
  - text as data
  - corpus
  - Spanish
  - political science
  - digital humanities
